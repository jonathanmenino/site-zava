---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: { title: string; description: string; updated: string };
}
const { title, description, updated } = Astro.props.frontmatter;
---

<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-b from-peach to-transparent pt-36 pb-10">
    <div class="container-zava max-w-3xl">
      <h1 class="text-4xl leading-tight sm:text-5xl" data-split>{title}</h1>
      <p class="mt-4 text-sm">Última atualização: {updated}</p>
    </div>
  </section>
  <article class="container-zava prose-zava max-w-3xl pb-10">
    <slot />
  </article>
</BaseLayout>
