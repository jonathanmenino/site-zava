---
// Carrossel 3D curvo (como se estivéssemos dentro de um cilindro). Roda sozinho e pode ser arrastado
// com o mouse/dedo ou rolado na horizontal pelo trackpad.
import { Image } from 'astro:assets';
import type { Criativo } from '../../data/cases';

interface Props { items: Criativo[]; label?: string }
const { items, label = 'Criativos da Zava' } = Astro.props;
---

<div class="cc" data-cc role="region" aria-roledescription="carrossel" aria-label={label} data-cursor="hover">
  <div class="cc-stage">
    {
      items.map((it, i) => (
        <figure class="cc-card" data-i={i}>
          <Image src={it.src} alt={it.alt} widths={[240, 400, 560]} sizes="(min-width: 1024px) 260px, 170px" class="cc-img" loading={i < 6 ? 'eager' : 'lazy'} draggable="false" />
        </figure>
      ))
    }
  </div>
</div>

<style>
  .cc {
    --card-w: clamp(120px, 14vw, 210px);
    position: relative;
    height: calc(var(--card-w) * 1.25 + 80px);
    perspective: 1100px;
    perspective-origin: 50% 40%;
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
    cursor: grab;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .cc.is-drag { cursor: grabbing; }
  .cc-stage {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .cc-card {
    position: absolute;
    left: 50%;
    top: 40px;
    width: var(--card-w);
    aspect-ratio: 4 / 5;
    margin: 0 0 0 calc(var(--card-w) / -2);
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-mist);
    box-shadow: 0 30px 60px -25px rgb(0 0 0 / 0.55), 0 0 0 1px rgb(127 127 127 / 0.15);
    backface-visibility: hidden;
    will-change: transform, opacity;
  }
  .cc-card :global(.cc-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  /* Antes do JS: fileira simples. */
  .cc:not(.is-ready) .cc-stage {
    display: flex;
    gap: 24px;
    justify-content: center;
  }
  .cc:not(.is-ready) .cc-card {
    position: relative;
    left: auto;
    margin: 0;
    flex: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cc]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('.cc-card')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let W = 0, gap = 0, L = 0, R = 0;
    const measure = () => {
      W = cards[0].offsetWidth;
      gap = W * 0.16;
      L = cards.length * (W + gap);
      R = Math.max(window.innerWidth * 0.4, W * 2.6); // raio do cilindro
    };
    measure();
    root.classList.add('is-ready');
    window.addEventListener('resize', measure);

    let offset = 0;
    let vel = 0;
    const auto = reduce ? 0 : -0.45; // px por quadro (60 fps)
    let hover = false;
    let dragging = false;
    let lastX = 0;
    let lastT = 0;
    let visible = true;

    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);

    const render = () => {
      cards.forEach((card, i) => {
        let x = (i * (W + gap) + offset) % L;
        if (x < 0) x += L;
        x -= L / 2;
        const theta = x / R;
        const abs = Math.abs(theta);
        if (abs > 1.3) {
          card.style.opacity = '0';
          return;
        }
        const tx = Math.sin(theta) * R;
        const tz = (1 - Math.cos(theta)) * R * 1.1 - 140;
        const ry = (-theta * 180) / Math.PI;
        const ty = Math.pow(abs, 2) * -18;
        card.style.transform = `translate3d(${tx.toFixed(1)}px, ${ty.toFixed(1)}px, ${tz.toFixed(1)}px) rotateY(${ry.toFixed(2)}deg)`;
        card.style.opacity = String(Math.max(0, Math.min(1, (1.3 - abs) * 2.5)));
        card.style.zIndex = String(Math.round(1000 - abs * 100));
      });
    };

    const loop = () => {
      if (visible) {
        if (!dragging) {
          vel *= 0.94;
          offset += vel + (hover ? auto * 0.35 : auto);
        }
        render();
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);

    root.addEventListener('pointerenter', () => (hover = true));
    root.addEventListener('pointerleave', () => (hover = false));
    root.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastX = e.clientX;
      lastT = performance.now();
      vel = 0;
      root.setPointerCapture(e.pointerId);
      root.classList.add('is-drag');
    });
    root.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      const now = performance.now();
      offset += dx * 1.1;
      vel = (dx * 1.1) / Math.max(1, (now - lastT) / 16.7);
      lastX = e.clientX;
      lastT = now;
    });
    const end = () => {
      dragging = false;
      root.classList.remove('is-drag');
    };
    root.addEventListener('pointerup', end);
    root.addEventListener('pointercancel', end);
    // Trackpad / roda na horizontal.
    root.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
        e.preventDefault();
        vel -= e.deltaX * 0.08;
      }
    }, { passive: false });
  });
</script>
