---
// Formulário simples do site. Envia os campos para site.formEndpoint (no site oficial, public/api/formulario.php,
// que confere o Turnstile e manda o e-mail) e mostra a mensagem de confirmação no lugar do formulário.
import { site } from '../../data/site';

export interface Campo {
  nome: string; // rótulo e nome do campo no e-mail
  tipo?: 'text' | 'tel' | 'number' | 'url' | 'select' | 'checkbox';
  opcoes?: string[];
  opcional?: boolean;
  placeholder?: string;
  autocomplete?: string;
  min?: number;
  max?: number;
}
interface Props {
  id: string;
  formulario: 'proposta' | 'trabalhe' | 'modelo';
  assunto: string;
  campos: Campo[];
  botao?: string;
  sucesso?: string;
}
const {
  id,
  formulario,
  assunto,
  campos,
  botao = 'Enviar',
  sucesso = 'Recebemos seus dados. Nossa equipe vai falar com você em breve.',
} = Astro.props;

const input =
  'mt-2 block w-full rounded-2xl border border-line/70 bg-page px-4 py-3 text-ink placeholder:text-ink/45 focus:border-orange focus:ring-2 focus:ring-orange/40 focus:outline-none';
---

<div class="form-zava" data-form-zava>
  <form id={id} class="grid gap-5" data-endpoint={site.formEndpoint} data-form={formulario} data-assunto={assunto} novalidate>
    {
      campos.map((c, i) => {
        const fid = `${id}-${i}`;
        const obrig = !c.opcional;
        const rotulo = (
          <>
            {c.nome}
            {c.opcional && <span class="font-normal text-ink/70"> (opcional)</span>}
          </>
        );
        if (c.tipo === 'checkbox')
          return (
            <fieldset data-grupo={obrig ? 'obrigatorio' : undefined}>
              <legend class="text-sm font-bold text-ink">
                {rotulo}
                <span class="font-normal text-ink/70"> (pode marcar mais de um)</span>
              </legend>
              <div class="mt-3 flex flex-wrap gap-2">
                {c.opcoes!.map((o) => (
                  <label class="opcao">
                    <input type="checkbox" name={c.nome} value={o} class="sr-only" />
                    <span>{o}</span>
                  </label>
                ))}
              </div>
              <p class="erro mt-2 hidden text-sm text-red-700 dark:text-red-300">Escolha pelo menos uma opção.</p>
            </fieldset>
          );
        return (
          <div>
            <label for={fid} class="text-sm font-bold text-ink">{rotulo}</label>
            {c.tipo === 'select' ? (
              <select id={fid} name={c.nome} required={obrig} class={input}>
                <option value="" disabled selected>Selecione</option>
                {c.opcoes!.map((o) => <option>{o}</option>)}
              </select>
            ) : (
              <input
                id={fid}
                name={c.nome}
                type={c.tipo ?? 'text'}
                required={obrig}
                placeholder={c.placeholder}
                autocomplete={c.autocomplete}
                min={c.min}
                max={c.max}
                inputmode={c.tipo === 'tel' ? 'tel' : c.tipo === 'number' ? 'numeric' : undefined}
                class={input}
              />
            )}
            <p class="erro mt-2 hidden text-sm text-red-700 dark:text-red-300">{c.tipo === 'tel' ? 'Informe um número com DDD.' : 'Preencha este campo.'}</p>
          </div>
        );
      })
    }
    <!-- Armadilha para robôs: fica escondida das pessoas. -->
    <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

    {
      site.turnstileSiteKey && (
        // Cloudflare Turnstile: só pede interação quando desconfia de robô.
        <div class="cf-turnstile empty:hidden" data-sitekey={site.turnstileSiteKey} data-appearance="interaction-only" data-language="pt-br" />
      )
    }

    <div class="flex flex-wrap items-center gap-4">
      <button type="submit" class="group inline-flex min-h-11 items-center gap-2 rounded-full bg-ink px-7 py-3 font-display text-xs font-bold tracking-wide text-page uppercase transition-colors hover:bg-purple hover:text-white disabled:opacity-60">
        <span data-rotulo>{botao}</span>
        <svg class="size-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <p class="falha hidden text-sm text-red-700 dark:text-red-300" role="alert">
        Não conseguimos enviar agora. Tente de novo ou chame a gente no
        <a href={site.whatsapp} target="_blank" rel="noopener" class="font-bold underline underline-offset-4">WhatsApp</a>.
      </p>
    </div>
  </form>

  <div class="enviado hidden rounded-3xl bg-peach p-8 text-center" role="status" tabindex="-1">
    <svg class="mx-auto size-12 text-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="10" /><path d="m7.5 12.5 3 3 6-6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <p class="mt-4 font-display text-xl font-bold text-ink">{sucesso}</p>
  </div>
</div>

{site.turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
  .opcao span {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-line) 70%, transparent);
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .opcao span:hover { border-color: var(--color-orange); }
  .opcao input:checked + span { background: var(--color-orange); border-color: var(--color-orange); color: var(--color-coal); }
  .opcao input:focus-visible + span { outline: 2px solid var(--color-orange); outline-offset: 2px; }
  .form-zava [aria-invalid='true'] { border-color: rgb(185 28 28); }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-form-zava] form').forEach((form) => {
    const caixa = form.closest('[data-form-zava]')!;
    const botao = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const rotulo = botao.querySelector<HTMLElement>('[data-rotulo]')!;
    const textoBotao = rotulo.textContent;
    const falha = form.querySelector<HTMLElement>('.falha')!;
    const abertoEm = performance.now();

    // Valida campo a campo e mostra a mensagem logo abaixo de cada um.
    const validar = () => {
      let primeiro: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>(`input[id^="${form.id}-"], select[id^="${form.id}-"]`).forEach((el) => {
        const digitos = el.value.replace(/\D/g, '').length;
        const ok =
          el.checkValidity() &&
          (!el.required || el.value.trim() !== '') &&
          (el.type !== 'tel' || !el.value.trim() || (digitos >= 10 && digitos <= 13));
        el.setAttribute('aria-invalid', String(!ok));
        el.parentElement!.querySelector('.erro')!.classList.toggle('hidden', ok);
        if (!ok && !primeiro) primeiro = el;
      });
      form.querySelectorAll<HTMLElement>('[data-grupo="obrigatorio"]').forEach((g) => {
        const ok = !!g.querySelector('input:checked');
        g.querySelector('.erro')!.classList.toggle('hidden', ok);
        if (!ok && !primeiro) primeiro = g.querySelector('input');
      });
      (primeiro as HTMLElement | null)?.focus();
      return !primeiro;
    };
    form.addEventListener('change', (e) => {
      const g = (e.target as HTMLElement).closest('[data-grupo]');
      if (g?.querySelector('input:checked')) g.querySelector('.erro')!.classList.add('hidden');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      falha.classList.add('hidden');
      if (!validar()) return;

      // Junta os campos; as opções marcadas viram uma lista separada por vírgula.
      const dados: Record<string, string> = {};
      new FormData(form).forEach((v, k) => {
        const t = String(v).trim();
        if (!t) return;
        dados[k] = dados[k] ? `${dados[k]}, ${t}` : t;
      });
      if (dados._honey) return;
      const endpoint = form.dataset.endpoint!;
      if (endpoint.includes('formsubmit.co')) {
        // Prévia no GitHub Pages (sem PHP): envia pelo FormSubmit.
        delete dados['cf-turnstile-response'];
        dados._subject = form.dataset.assunto!;
        dados._template = 'table';
        dados._captcha = 'false';
      } else {
        dados._form = form.dataset.form!;
        dados._tempo = String(Math.round(performance.now() - abertoEm));
      }

      botao.disabled = true;
      rotulo.textContent = 'Enviando…';
      try {
        const r = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(dados),
        });
        const j = await r.json().catch(() => ({}));
        if (!r.ok || String(j.success) !== 'true') throw new Error(j.message || r.status);
        form.classList.add('hidden');
        const ok = caixa.querySelector<HTMLElement>('.enviado')!;
        ok.classList.remove('hidden');
        ok.focus();
      } catch {
        falha.classList.remove('hidden');
        // O selo do Turnstile vale para um envio só: pede um novo para a próxima tentativa.
        (window as any).turnstile?.reset(form.querySelector('.cf-turnstile'));
      } finally {
        botao.disabled = false;
        rotulo.textContent = textoBotao;
      }
    });
  });
</script>
