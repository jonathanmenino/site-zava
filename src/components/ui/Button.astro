---
interface Props {
  href: string;
  variant?: 'dark' | 'outline-light' | 'light' | 'link';
  external?: boolean;
  class?: string;
}
const { href, variant = 'dark', external = false, class: className } = Astro.props;

const styles = {
  dark: 'rounded-full bg-ink px-6 py-3 text-white hover:bg-purple',
  light: 'rounded-full bg-white px-6 py-3 text-ink hover:bg-peach',
  'outline-light': 'rounded-full border border-white/70 px-6 py-3 text-white hover:bg-white hover:text-ink',
  link: 'border-b-2 border-orange pb-1 text-ink hover:text-orange',
};
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-2 font-display text-xs font-bold uppercase tracking-wide transition-colors',
    styles[variant],
    className,
  ]}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  <slot />
  {
    variant !== 'link' && (
      <svg class="size-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
</a>
