---
// Página curta com título, texto e um formulário (Trabalhe na Zava, Sou modelo).
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormZava, { type Campo } from '../ui/FormZava.astro';
import { site } from '../../data/site';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  titulo: string;
  texto: string;
  id: string;
  assunto: string;
  campos: Campo[];
  botao: string;
  sucesso: string;
}
const p = Astro.props;
---

<BaseLayout title={p.title} description={p.description}>
  <section class="bg-gradient-to-b from-peach to-transparent pt-32 pb-8 lg:pt-40">
    <div class="container-zava grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div class="lg:sticky lg:top-32">
        <p class="font-display text-xs font-bold tracking-[0.2em] text-orange uppercase" data-reveal="fade">{p.eyebrow}</p>
        <h1 class="mt-4 text-4xl leading-tight sm:text-5xl" data-split>{p.titulo}</h1>
        <p class="mt-6 max-w-md text-ink" data-reveal style="--reveal-delay: 300ms">{p.texto}</p>
        <p class="mt-6 text-sm" data-reveal style="--reveal-delay: 400ms">
          Dúvidas? Escreva para <a href={`mailto:${site.email}`} class="font-bold text-ink underline underline-offset-4 hover:text-orange">{site.email}</a>.
        </p>
      </div>
      <div id="formulario" data-reveal style="--reveal-delay: 250ms">
        <div class="rounded-3xl bg-surface p-6 shadow-sm sm:p-8">
          <FormZava id={p.id} assunto={p.assunto} campos={p.campos} botao={p.botao} sucesso={p.sucesso} />
        </div>
        <p class="mt-4 text-xs">
          Usamos esses dados só para entrar em contato com você. Saiba mais na
          <a href="/politica-de-privacidade/" class="underline underline-offset-4 hover:text-orange">Política de Privacidade</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // No celular o botão flutuante do WhatsApp cobria o botão "Enviar": ele some enquanto o formulário está na tela.
  const form = document.getElementById('formulario');
  const float = document.getElementById('whatsapp-float');
  if (form && float && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => float.toggleAttribute('data-hidden', entry.isIntersecting), { threshold: 0.1 }).observe(form);
  }
</script>
