---
// Alterna entre modo diurno e noturno. A escolha fica salva no navegador.
---

<button
  id="theme-toggle"
  type="button"
  class="relative inline-flex h-11 w-[4.5rem] shrink-0 items-center rounded-full border border-line/50 bg-surface/60 p-1 backdrop-blur transition-colors hover:border-orange"
  aria-label="Ativar modo noturno"
  aria-pressed="false"
>
  <span class="theme-knob absolute top-1 left-1 inline-flex size-9 items-center justify-center rounded-full bg-ink text-page shadow transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] dark:translate-x-[1.75rem]">
    <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
    </svg>
  </span>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    btn?.setAttribute('aria-pressed', String(dark));
    btn?.setAttribute('aria-label', dark ? 'Ativar modo diurno' : 'Ativar modo noturno');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0c0b0e' : '#ffffff');
  };
  sync();
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('zava-theme', next);
    } catch {}
    sync();
    window.dispatchEvent(new CustomEvent('zava:theme', { detail: next }));
  });
</script>
