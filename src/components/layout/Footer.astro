---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import { site, careers } from '../../data/site';

import { getServicos } from '../../lib/servicos';

const servicos = await getServicos();
const year = new Date().getFullYear();
---

<footer class="mt-24">
  <div class="rounded-t-[2.5rem] bg-gradient-to-b from-purple to-purple-light pt-16 pb-24 text-white">
    <div class="container-zava grid items-center gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <Logo id="logo-footer" class="h-6 w-auto" />
        <p class="mt-4 font-display text-3xl leading-tight font-bold sm:text-4xl">Marketing 360°, resultados</p>
      </div>
      <div class="grid gap-8 rounded-3xl bg-surface p-8 text-ink sm:grid-cols-2 sm:p-10">
        <div class="text-center sm:text-left">
          <p>Pronto para transformar o marketing da sua empresa?</p>
          <a href={`mailto:${site.email}`} class="mt-4 block hover:text-orange">{site.email}</a>
          <a href={site.whatsapp} target="_blank" rel="noopener" class="block font-display text-2xl font-bold hover:text-orange">{site.phone}</a>
          <Button href="/contato/" class="mt-6">Pedir uma proposta</Button>
        </div>
        <address class="self-end text-center not-italic sm:text-left">
          <a href={site.address.maps} target="_blank" rel="noopener" class="hover:text-orange">
            {site.address.line1}<br />{site.address.line2}
          </a>
        </address>
      </div>
    </div>
  </div>

  <div class="-mt-10 rounded-t-[2.5rem] bg-coal pt-12 pb-24 text-white/90 sm:pb-12">
    <div class="container-zava">
      <p class="font-display text-xs font-bold tracking-wider text-white uppercase">Links rápidos</p>
      <ul class="mt-4 grid gap-x-10 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          servicos.map((s) => (
            <li>
              <a href={`/servicos/${s.id}/`} class="hover:text-orange">{s.data.title}</a>
            </li>
          ))
        }
        <li><a href={careers.colaborador} class="hover:text-orange">Trabalhe na Zava</a></li>
        <li><a href={careers.modelo} class="hover:text-orange">Sou modelo</a></li>
      </ul>

      <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 text-sm sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p>Agência Zava - {year} © Todos os direitos reservados.</p>
          <p class="mt-1 flex gap-4">
            <a href="/termos-e-condicoes/" class="hover:text-orange">Termos e Condições</a>
            <a href="/politica-de-privacidade/" class="hover:text-orange">Política de Privacidade</a>
          </p>
        </div>
        <a href={site.instagram} target="_blank" rel="noopener" class="inline-flex size-10 items-center justify-center rounded-full bg-white/10 hover:bg-orange" aria-label="Instagram da Agência Zava">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
