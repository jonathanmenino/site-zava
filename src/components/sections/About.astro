---
import { Image } from 'astro:assets';
import foto from '../../assets/stock/reuniao-consultoria.webp';
import foto2 from '../../assets/stock/videomaker-gravando.webp';

// Números da agência (passados pelo dono em 2026-11-26). O tamanho da equipe não deve ser divulgado.
const numeros = [
  { antes: '', valor: 2016, conta: false, depois: '', label: 'No mercado desde' },
  { antes: '+', valor: 250, conta: true, depois: '', label: 'Clientes atendidos' },
  { antes: '+', valor: 25, conta: true, depois: ' mil', label: 'Projetos produzidos' },
  { antes: '', valor: 3, conta: false, depois: ' países', label: 'Clientes em todo o Brasil, nos EUA e na Rússia' },
];
---

<section id="sobre" class="relative overflow-hidden py-24 lg:py-36">
  <!-- Camadas em velocidades diferentes: textura, fotos e texto. -->
  <div class="pointer-events-none absolute top-10 -left-24 hidden w-52 lg:block xl:-left-10 xl:w-64" aria-hidden="true">
    <div data-parallax="0.35">
      <Image src={foto} alt="" width={420} class="aspect-[3/4] w-full rounded-[1.75rem] object-cover opacity-90 shadow-2xl" data-reveal="left" />
    </div>
  </div>
  <div class="pointer-events-none absolute -right-20 bottom-0 hidden w-56 lg:block xl:-right-6 xl:w-72" aria-hidden="true">
    <div data-parallax="-0.25">
      <Image src={foto2} alt="" width={460} class="aspect-[4/5] w-full rounded-[1.75rem] object-cover opacity-90 shadow-2xl" data-reveal="right" />
    </div>
  </div>

  <div class="container-zava relative max-w-4xl text-center">
    <p class="font-display text-xs font-bold tracking-[0.2em] text-orange uppercase" data-reveal="fade">Quem somos</p>
    <h2 class="mx-auto mt-6 max-w-3xl text-2xl leading-[1.25] font-bold sm:text-[2.1rem] sm:leading-[1.2] lg:max-w-2xl lg:text-[1.9rem] xl:max-w-3xl xl:text-[2.4rem]" data-scrub-words>
      Mais do que uma agência de social media, somos parceiros estratégicos do seu crescimento. Planejamos, criamos e executamos marketing completo,
      unindo criatividade, tecnologia e dados para gerar resultados reais.
    </h2>
    <p class="mt-10 font-display text-sm font-bold tracking-wide text-purple uppercase dark:text-purple-light" data-reveal>
      Aqui, cada ação tem um objetivo: fazer o seu negócio vender mais.
    </p>

    <ul class="mx-auto mt-14 grid max-w-3xl grid-cols-2 gap-x-6 gap-y-10 border-t border-line/60 pt-10 sm:grid-cols-4">
      {
        numeros.map((n, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 100}ms`}>
            <p class="font-display text-4xl leading-none font-extrabold whitespace-nowrap text-ink sm:text-[2.6rem]">
              <span class="text-orange">{n.antes}</span>{n.conta ? <span data-count={n.valor}>{n.valor}</span> : n.valor}{n.depois && <span class="text-[0.6em]">{n.depois}</span>}
            </p>
            <p class="mx-auto mt-3 max-w-[12rem] text-sm leading-snug">{n.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { contarNumeros } from '../../scripts/contador';
  contarNumeros();
</script>
