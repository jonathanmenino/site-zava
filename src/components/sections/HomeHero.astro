---
import Button from '../ui/Button.astro';
import NeonSign from '../hero/NeonSign.astro';
import CreativeCarousel from '../hero/CreativeCarousel.astro';
import { destaquesHero } from '../../data/cases';
import { site } from '../../data/site';
---

<section class="hero relative isolate flex min-h-[100svh] flex-col overflow-hidden pt-24 sm:pt-28" data-neon-host>
  <!-- Fundo: textura e luzes que andam mais devagar que o conteúdo (parallax). -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="bg-texture absolute inset-x-0 -top-20 -bottom-40 opacity-60 [mask-image:radial-gradient(70%_60%_at_50%_40%,#000,transparent)]" data-parallax="0.25"></div>
    <div class="absolute top-[38%] left-1/2 h-[34rem] w-[62rem] max-w-[140vw] -translate-x-1/2 rounded-full bg-orange/10 blur-[120px] dark:bg-orange/[0.07]" data-parallax="0.12"></div>
  </div>

  <div class="container-zava relative z-10 text-center">
    <p class="font-display text-[0.7rem] font-bold tracking-[0.2em] text-orange uppercase sm:text-xs" data-reveal="fade">Agência de Marketing 360° · Limeira – SP</p>
    <h1 class="mx-auto mt-4 max-w-5xl text-[2.3rem] leading-[1.05] sm:text-5xl lg:text-[3.6rem]" data-split>
      Marketing 360° que <span class="text-orange">transforma</span> estratégias em vendas
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-[0.95rem] sm:text-base" data-reveal style="--reveal-delay: 450ms">
      Muito além das redes sociais: criamos estratégias completas de marketing que geram resultados reais para o seu negócio.
    </p>
    <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-8" data-reveal style="--reveal-delay: 600ms">
      <Button href="/contato/" variant="primary">Pedir proposta</Button>
      <a href={site.whatsapp} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-ink underline decoration-line underline-offset-4 hover:text-orange hover:decoration-orange">
        Falar com um especialista
      </a>
    </div>
  </div>

  <!-- Letreiro de neon ao fundo, entre o texto e o carrossel. -->
  <div class="relative flex min-h-44 flex-1 sm:min-h-56 items-center justify-center">
    <div class="absolute top-1/2 left-1/2 w-[min(86vw,780px)] -translate-x-1/2 -translate-y-[50%]" data-reveal="scale" style="--reveal-delay: 300ms">
      <div data-parallax="-0.1"><NeonSign /></div>
    </div>
  </div>

  <div class="relative z-10 -mt-10 sm:-mt-16" data-reveal style="--reveal-delay: 750ms">
    <CreativeCarousel items={destaquesHero} label="Alguns criativos da Zava" />
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(120% 70% at 50% 0%, color-mix(in oklab, var(--color-peach) 70%, transparent), transparent 70%),
      var(--color-page);
  }
  :global([data-theme='dark']) .hero {
    background:
      radial-gradient(90% 60% at 50% 45%, rgb(255 104 0 / 0.06), transparent 70%),
      #070608;
  }
</style>
