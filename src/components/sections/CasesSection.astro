---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Eyebrow from '../ui/Eyebrow.astro';
import CurveDivider from '../ui/CurveDivider.astro';
import ClientLogos from './ClientLogos.astro';
import CaseCard from './CaseCard.astro';
import clientes from '../../assets/stock/cliente-cafeteria.webp';
import foguete from '../../assets/brand/foguete.png';

const cases = (await getCollection('trabalhos')).sort((a, b) => a.data.order - b.data.order);
---

<section id="cases" class="pt-16 lg:pt-20">
  <div class="container-zava grid items-center gap-12 lg:grid-cols-2">
    <div class="lg:pl-16">
      <Eyebrow>Cases de sucesso</Eyebrow>
      <h2 class="mt-3 text-4xl leading-tight text-purple sm:text-5xl">Resultados que falam por si</h2>
      <p class="mt-6 max-w-sm">
        Cada projeto é pensado para gerar <strong>impacto real</strong>. Confira alguns dos negócios que cresceram com nosso <strong>Marketing 360°</strong>.
      </p>
    </div>
    <Image src={clientes} alt="Donos de uma cafeteria sorrindo atrás do balcão" width={640} class="w-full max-w-md justify-self-center rounded-[2rem] object-cover shadow-[0_30px_60px_-30px_rgba(107,1,208,0.45)] lg:aspect-square" />
  </div>

  <div class="mt-12"><ClientLogos /></div>
  <CurveDivider />

  <div class="container-zava relative mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {cases.map((c, i) => <CaseCard entry={c} featured={i === 0} />)}
    <Image src={foguete} alt="" width={200} class="pointer-events-none absolute -top-16 -right-2 hidden w-20 lg:block" />
  </div>
</section>
