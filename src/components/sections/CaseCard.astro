---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Tag from '../ui/Tag.astro';

interface Props { entry: CollectionEntry<'trabalhos'> }
const { entry } = Astro.props;
const d = entry.data;
---

<a href={`/trabalhos/${entry.id}/`} class="group relative isolate block aspect-[4/3.3] overflow-hidden rounded-[2rem] text-white">
  <Image src={d.cover} alt={d.coverAlt} width={720} class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-500 group-hover:scale-105" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/50 via-black/30 to-black/70"></div>
  <div class="flex h-full flex-col p-7">
    <p class="font-display text-lg font-bold">{d.client}</p>
    <div class="mt-auto">
      <p class="font-display text-2xl leading-tight font-extrabold uppercase sm:text-3xl">{d.highlight}</p>
      <p class="font-display text-sm font-bold uppercase">{d.highlightLabel}</p>
      <div class="mt-4 flex flex-wrap gap-2 border-t border-white/60 pt-4">
        {d.tags.map((t) => <Tag>{t}</Tag>)}
      </div>
    </div>
  </div>
</a>
