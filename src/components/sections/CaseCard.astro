---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Tag from '../ui/Tag.astro';

// featured = card largo com resumo e números (usado quando há um case em destaque).
interface Props { entry: CollectionEntry<'trabalhos'>; featured?: boolean }
const { entry, featured = false } = Astro.props;
const d = entry.data;
const href = `/trabalhos/${entry.id}/`;
---

{
  featured ? (
    <a href={href} class="group grid overflow-hidden rounded-[2rem] bg-ink text-white sm:col-span-2 lg:col-span-3 lg:grid-cols-[1.15fr_1fr]">
      <div class="relative aspect-[4/3] overflow-hidden lg:aspect-auto">
        <Image src={d.cover} alt={d.coverAlt} width={900} class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
      <div class="flex flex-col p-8 sm:p-10 lg:p-12">
        <p class="font-display text-xs font-bold uppercase tracking-wider text-orange">Case em destaque · {d.client}</p>
        <p class="mt-4 font-display text-4xl leading-none font-extrabold uppercase sm:text-5xl">{d.highlight}</p>
        <p class="mt-2 font-display text-sm font-bold uppercase text-white/80">{d.highlightLabel}</p>
        <p class="mt-6 text-white/80">{d.summary}</p>
        <dl class="mt-8 grid gap-5 border-t sm:grid-cols-3 sm:gap-6 border-white/20 pt-6">
          {d.results.slice(0, 3).map((r) => (
            <div>
              <dt class="sr-only">{r.label}</dt>
              <dd class="font-display text-xl font-extrabold whitespace-nowrap text-orange xl:text-2xl">{r.value}</dd>
              <dd class="mt-1 text-xs text-white/70">{r.label}</dd>
            </div>
          ))}
        </dl>
        <span class="mt-auto inline-flex items-center gap-2 pt-8 font-display text-xs font-bold uppercase tracking-wide text-white group-hover:text-orange">
          Ver case completo
          <svg class="size-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </div>
    </a>
  ) : (
    <a href={href} class="group relative isolate block aspect-[4/3.3] overflow-hidden rounded-[2rem] text-white">
      <Image src={d.cover} alt={d.coverAlt} width={720} class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-500 group-hover:scale-105" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/50 via-black/40 to-black/85"></div>
      <div class="flex h-full flex-col p-7">
        <p class="font-display text-lg font-bold">{d.client}</p>
        <div class="mt-auto">
          <p class="font-display text-2xl leading-tight font-extrabold uppercase sm:text-3xl">{d.highlight}</p>
          <p class="font-display text-sm font-bold uppercase">{d.highlightLabel}</p>
          <div class="mt-4 flex flex-wrap gap-2 border-t border-white/60 pt-4">
            {d.tags.map((t) => <Tag>{t}</Tag>)}
          </div>
        </div>
      </div>
    </a>
  )
}
