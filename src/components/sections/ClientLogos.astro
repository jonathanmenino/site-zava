---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Logos de clientes do site atual. O nome do arquivo vira o texto alternativo.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/clients/*.png', { eager: true });
const names: Record<string, string> = {
  'altegio': 'Altegio', 'bem-viver': 'Bem Viver', 'bono-churros': 'Bono Churros', 'bravus': 'Bravus',
  'emboava': 'Emboava', 'intensiva': 'Intensiva', 'jd-sul-2': 'Jardim Sul', 'kyoto': 'Kyoto',
  'lomani': 'Lomani', 'macarrone': 'Macarrone In Box', 'ouro-verde': 'Ouro Verde', 'papa-rica': 'Papa Rica',
  'plaype': 'Playpé', 'pq-hipolyto': 'Parque Hipolyto', 'zecon': 'Zecon',
};
const logos = Object.entries(files).map(([path, mod]) => {
  const slug = path.split('/').pop()!.replace('.png', '');
  return { src: mod.default, alt: names[slug] ?? slug };
});
---

<div class="relative overflow-hidden py-10" aria-label="Clientes da Agência Zava">
  <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-page sm:w-32"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-page sm:w-32"></div>
  <ul class="flex w-max animate-marquee items-center gap-14 hover:[animation-play-state:paused]">
    {
      [...logos, ...logos].map((logo, i) => (
        <li aria-hidden={i >= logos.length ? 'true' : undefined}>
          <Image src={logo.src} alt={i >= logos.length ? '' : logo.alt} height={64} class="h-14 w-auto object-contain sm:h-16 dark:contrast-125 dark:grayscale dark:invert dark:opacity-90" />
        </li>
      ))
    }
  </ul>
</div>
