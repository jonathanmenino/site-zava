---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import FormZava from '../components/ui/FormZava.astro';
import { site, careers } from '../data/site';

const campos = [
  { nome: 'Nome', autocomplete: 'name' },
  { nome: 'Empresa', autocomplete: 'organization' },
  { nome: 'WhatsApp', tipo: 'tel', autocomplete: 'tel', placeholder: '(19) 99999-9999' },
  { nome: 'Instagram', placeholder: '@suaempresa' },
  {
    nome: 'Faturamento mensal',
    tipo: 'select',
    opcoes: ['Até 50 mil', '50 a 100 mil', '100 a 200 mil', '200 a 400 mil', '400 mil a 1 milhão', 'Mais de 1 milhão'],
  },
  {
    nome: 'Qual serviço você procura?',
    tipo: 'checkbox',
    opcoes: [
      'Gestão de Redes Sociais',
      'Gestão de Tráfego Pago',
      'Criação de Sites e Landing Pages',
      'Identidade Visual e Design',
      'Produção Audiovisual',
      'Consultoria e Estratégia de Marketing',
      'Ainda não sei',
    ],
  },
] as const;
---

<BaseLayout title="Contato" description="Fale com a Agência Zava: peça uma proposta pelo formulário, WhatsApp ou e-mail. Atendimento de segunda a sexta, das 8h às 17h. Av. Campinas, 1755, Limeira – SP.">
  <section class="bg-gradient-to-b from-peach to-transparent pt-32 pb-16 lg:pt-40">
    <div class="container-zava grid gap-12 lg:grid-cols-2">
      <div>
        <h1 class="text-4xl leading-tight sm:text-5xl" data-split>Conte sobre o seu negócio. A gente monta a proposta.</h1>
        <p class="mt-6 max-w-md text-ink" data-reveal style="--reveal-delay: 300ms">
          Preencha o formulário e deixe que a nossa equipe cuide do marketing completo da sua marca, enquanto você foca em fazer o que mais gosta:
          <strong>vender e crescer</strong>.
        </p>

        <dl data-reveal style="--reveal-delay: 400ms" class="mt-8 grid gap-6 rounded-3xl bg-surface p-6 shadow-sm sm:grid-cols-2">
          <div>
            <dt class="text-sm">WhatsApp:</dt>
            <dd><a href={site.whatsapp} target="_blank" rel="noopener" class="text-lg text-ink hover:text-orange">{site.phone}</a></dd>
          </div>
          <div>
            <dt class="text-sm">Instagram:</dt>
            <dd><a href={site.instagram} target="_blank" rel="noopener" class="text-lg text-ink hover:text-orange">{site.instagramHandle}</a></dd>
          </div>
          <div>
            <dt class="text-sm">E-mail:</dt>
            <dd><a href={`mailto:${site.email}`} class="text-lg break-words text-ink hover:text-orange">{site.email}</a></dd>
          </div>
          <div>
            <dt class="text-sm">Atendimento:</dt>
            <dd class="text-lg text-ink">{site.hours}</dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-wrap items-center gap-6">
          <address class="flex items-start gap-3 text-ink not-italic">
            <svg class="mt-1 size-5 shrink-0 text-orange" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" /></svg>
            <span>{site.address.line1}<br />{site.address.line2}</span>
          </address>
          <Button href={site.address.maps} variant="link" external>Ver no mapa</Button>
        </div>
      </div>

      <div id="formulario" data-reveal style="--reveal-delay: 250ms">
        <div class="rounded-3xl bg-surface p-6 shadow-sm sm:p-8">
          <FormZava
            id="form-proposta"
            formulario="proposta"
            assunto="Novo pedido de proposta pelo site"
            campos={campos as any}
            botao="Quero uma proposta"
            sucesso="Recebemos seus dados. Nossa equipe vai analisar seu perfil e falar com você em breve."
          />
        </div>
        <p class="mt-4 text-sm">
          Prefere conversar agora? Chame a gente no
          <a href={site.whatsapp} target="_blank" rel="noopener" class="font-bold text-ink underline underline-offset-4 hover:text-orange">WhatsApp</a>.
        </p>
        <p class="mt-2 text-xs">
          Usamos os dados do formulário só para entrar em contato sobre a sua proposta. Saiba mais na
          <a href="/politica-de-privacidade/" class="underline underline-offset-4 hover:text-orange">Política de Privacidade</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="container-zava">
    <iframe
      src={site.address.embed}
      title="Mapa: Agência Zava em Limeira – SP"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="h-80 w-full rounded-[2rem] border-0"></iframe>
  </section>

  <section class="container-zava mt-20">
    <div class="rounded-[2rem] bg-orange px-6 py-14 text-center">
      <h2 class="text-3xl text-coal sm:text-5xl">Quer trabalhar com a Zava?</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href={careers.colaborador} variant="coal">Quero ser colaborador</Button>
        <Button href={careers.modelo} variant="coal">Sou modelo</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // No celular o botão flutuante do WhatsApp cobria o botão "Enviar" do formulário:
  // ele some enquanto o formulário está na tela.
  const form = document.getElementById('formulario');
  const float = document.getElementById('whatsapp-float');
  if (form && float && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      float.toggleAttribute('data-hidden', entry.isIntersecting);
    }, { threshold: 0.1 }).observe(form);
  }
</script>
