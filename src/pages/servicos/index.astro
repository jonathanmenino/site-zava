---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicesGrid from '../../components/sections/ServicesGrid.astro';
import CtaBanner from '../../components/sections/CtaBanner.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
---

<BaseLayout title="Serviços" description="Redes sociais, tráfego pago, sites, identidade visual, produção audiovisual e consultoria: conheça os serviços de Marketing 360° da Agência Zava.">
  <section class="bg-gradient-to-b from-peach to-transparent pt-36 pb-12 text-center">
    <div class="container-zava">
      <Eyebrow data-reveal="fade">Serviços</Eyebrow>
      <h1 class="mx-auto mt-3 max-w-3xl text-4xl leading-tight sm:text-6xl" data-split>Tudo o que a sua marca precisa para vender mais</h1>
    </div>
  </section>
  <ServicesGrid />
  <CtaBanner />
</BaseLayout>
