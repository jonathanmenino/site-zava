---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import CurveDivider from '../../components/ui/CurveDivider.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import Faq from '../../components/sections/Faq.astro';
import CtaBanner from '../../components/sections/CtaBanner.astro';
import { inlineMd } from '../../lib/inline-md';
import foguete from '../../assets/brand/foguete.png';

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'servicos'> }
const { entry } = Astro.props;
const d = entry.data;
---

<BaseLayout title={d.title} description={d.seoDescription} image={d.hero.image}>
  <section class="bg-gradient-to-b from-peach to-white pt-32 pb-16 lg:pt-40">
    <div class="container-zava grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h1 class="text-4xl leading-tight sm:text-6xl">{d.title}</h1>
        <p class="mt-6 text-ink">{d.hero.intro}</p>
        <Button href="/contato/" class="mt-8">Pedir uma proposta</Button>
      </div>
      <Image src={d.hero.image} alt={d.hero.imageAlt} width={720} class="aspect-[1.1] w-full rounded-[2rem] object-cover" loading="eager" />
    </div>
  </section>

  <CurveDivider />

  <section class="container-zava pt-12 text-center">
    <Eyebrow>O que a Zava faz por você</Eyebrow>
    <h2 class="text-gradient mt-4 text-3xl leading-tight sm:text-5xl">
      {d.headline.map((line) => <span class="block">{line}</span>)}
    </h2>
  </section>

  <section class="container-zava mt-14">
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        d.features.map((f, i) => (
          <li class:list={['flex flex-col rounded-[2rem] p-8', i % 3 === 1 ? 'bg-peach' : 'bg-mist']}>
            <span class="font-display text-4xl font-extrabold text-purple" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-6 text-2xl leading-tight">{f.title}</h3>
            <p class="mt-3" set:html={inlineMd(f.text)} />
          </li>
        ))
      }
      <li class:list={['flex flex-col justify-between gap-6 rounded-[2rem] bg-purple p-8 text-white', d.features.length % 3 === 1 && 'sm:col-span-2']}>
        <p class="font-display text-2xl leading-tight font-bold">Quer ver isso funcionando na sua marca?</p>
        <Button href="/contato/" variant="primary" class="self-start">Pedir uma proposta</Button>
      </li>
    </ol>
  </section>

  <CurveDivider class="mt-12" />

  <section class="container-zava grid items-center gap-12 py-16 lg:grid-cols-2">
    <div>
      <h2 class="text-gradient text-4xl leading-tight sm:text-5xl">Por que escolher a Zava</h2>
      <ul class="mt-8 space-y-4">
        {
          d.why.items.map((item) => (
            <li class="flex gap-3">
              <svg class="mt-0.5 size-5 shrink-0 text-orange" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1.2 14.2-4.2-4.2 1.4-1.4 2.8 2.8 5.6-5.6 1.4 1.4-7 7Z" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <Image src={d.why.image} alt={d.why.imageAlt} width={720} class="aspect-[4/3] w-full rounded-[2rem] object-cover" />
  </section>

  <Testimonials service={entry.id} />

  <div class="relative">
    <Faq items={d.faq} />
    <Image src={foguete} alt="" width={200} class="pointer-events-none absolute right-[8%] bottom-0 hidden w-24 lg:block" />
  </div>

  <CtaBanner />
</BaseLayout>
