---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Página não encontrada" noindex>
  <section class="bg-gradient-to-b from-peach to-transparent pt-40 pb-20 text-center">
    <div class="container-zava">
      <p class="text-gradient font-display text-8xl font-extrabold">404</p>
      <h1 class="mt-4 text-3xl sm:text-4xl" data-split>Essa página saiu da campanha.</h1>
      <p class="mx-auto mt-4 max-w-md">O endereço pode ter mudado com o novo site. Que tal voltar para o início ou falar com a gente?</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href="/">Ir para o início</Button>
        <Button href="/contato/" variant="link">Fale com a Zava</Button>
      </div>
    </div>
  </section>
</BaseLayout>
